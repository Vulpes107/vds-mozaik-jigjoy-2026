{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masterplan.local/contracts/company_profile.schema.json",
  "title": "CompanyProfile",
  "description": "User input that starts a run.",
  "type": "object",
  "required": ["schema_version", "name", "description", "products"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "project_id": { "$ref": "common.schema.json#/$defs/id", "description": "Optional p_ id; re-running a project creates a new run." },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "industry": { "type": "string" },
    "headcount": { "type": "integer", "minimum": 0 },
    "countries": { "type": "array", "items": { "type": "string" } },
    "languages": { "type": "array", "items": { "type": "string" } },
    "currency": { "$ref": "common.schema.json#/$defs/currency" },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "stage": { "enum": ["idea", "prototype", "launched", "growth", "mature", "declining"] },
          "annual_revenue": { "type": "number", "minimum": 0 },
          "annual_cost": { "type": "number", "minimum": 0 }
        }
      }
    },
    "financials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annual_revenue": { "type": "number" },
        "monthly_burn": { "type": "number" },
        "cash_on_hand": { "type": "number" },
        "investable_budget": { "type": "number" }
      }
    },
    "goals": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "risk_appetite": { "enum": ["low", "medium", "high"], "default": "medium" },
    "horizon_years": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
    "notes": { "type": "string" },
    "run_budget": { "$ref": "common.schema.json#/$defs/budget" }
  }
}
