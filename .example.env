# Copy to .env and fill in. Never commit .env.

# Mozaik cloud project key (app.jigjoy.ai). Optional if you ran `npx @mozaik-ai/cloud-sdk pair`.
MOZAIK_API_KEY=pk_...

# Provider keys: set the ones for the models you use.
OPENAI_API_KEY=
# Hackathon inference gateway (Sonnet 4.6 + Haiku 4.5 only, $20 team budget). The Anthropic SDK reads both; no code change.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Research (Machine B): Tavily search/extract. Each machine uses its own key(s).
# Several keys may be listed comma-separated; they are used one after another as each hits its quota.
TAVILY_API_KEY=
# Optional fallback providers for Tavily rate limits (src/research/tools/{parallel,you,firecrawl}.ts).
# All work with NO key/account at all (accountless free tiers). Set these only to raise their limits.
PARALLEL_API_KEY=
FIRECRAWL_API_KEY=
# You.com's keyless Search MCP has no key option at all; nothing to set.
