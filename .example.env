# Copy to .env and fill in. Never commit .env.

# Mozaik cloud project key (app.jigjoy.ai). Optional if you ran `npx @mozaik-ai/cloud-sdk pair`.
MOZAIK_API_KEY=pk_...

# Provider keys: set the ones for the models you use.
OPENAI_API_KEY=
# Hackathon inference gateway (Sonnet 4.6 + Haiku 4.5 only, $20 team budget). The Anthropic SDK reads both; no code change.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Research (Machine B): Tavily search/extract. Each machine uses its own key.
TAVILY_API_KEY=
# Optional fallback provider for Tavily rate limits: Parallel's Search MCP (src/research/tools/parallel.ts).
# Works with NO key at all (accountless, anonymous rate limit). Set this only to raise that limit.
PARALLEL_API_KEY=
